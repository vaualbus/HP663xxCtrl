<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFE0E0E0"/>

    <SolidColorBrush x:Key="GroupBoxBackgroundBrush" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#FFD08A3E"/>

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF252526"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF252526"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFE0E0E0"/>

    <SolidColorBrush x:Key="SplitterBackgroundBrush" Color="#FF3A3A3A"/>

    <!-- TextBox / ComboBox / numeric input boxes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF6A6A6A"/>

    <!-- ZedGraph colors (applied in code-behind since the graph is WinForms-hosted) -->
    <Color x:Key="GraphBackColor">#FF2A2A2A</Color>
    <Color x:Key="GraphForeColor">#FFE0E0E0</Color>

</ResourceDictionary>
