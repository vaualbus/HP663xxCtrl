<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme (VS Code-inspired neutrals + a cool blue accent, replacing the
         original orange branding which clashed with a neutral dark palette) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFD4D4D4"/>

    <SolidColorBrush x:Key="GroupBoxBackgroundBrush" Color="#FF252526"/>
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#FF3E7CB1"/>

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFD4D4D4"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF3A3D41"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFD4D4D4"/>

    <SolidColorBrush x:Key="SplitterBackgroundBrush" Color="#FF3A3A3A"/>

    <!-- TextBox / ComboBox / numeric input boxes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF6B6B6B"/>

    <!-- ZedGraph colors (applied in code-behind since the graph is WinForms-hosted) -->
    <Color x:Key="GraphBackColor">#FF1E1E1E</Color>
    <Color x:Key="GraphForeColor">#FFD4D4D4</Color>

    <!-- Default WPF control chrome (TabControl content pane, disabled ComboBox,
         Menu popups, selection highlight, etc.) reads these SystemColors keys
         directly, bypassing plain Background/Foreground setters - override them
         so native chrome matches the theme instead of showing stock white/gray. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF3A3D41"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF4A4D51"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF505050"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3E7CB1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#FF3A3A3A"/>

</ResourceDictionary>

