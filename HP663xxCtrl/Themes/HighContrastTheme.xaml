<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High Contrast theme (accessibility: pure black/white/yellow) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="GroupBoxBackgroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#FFFFFF00"/>

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF000000"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF00"/>

    <SolidColorBrush x:Key="SplitterBackgroundBrush" Color="#FFFFFF00"/>

    <!-- TextBox / ComboBox / numeric input boxes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFFFFF00"/>

    <!-- ZedGraph colors (applied in code-behind since the graph is WinForms-hosted) -->
    <Color x:Key="GraphBackColor">#FF000000</Color>
    <Color x:Key="GraphForeColor">#FFFFFFFF</Color>

</ResourceDictionary>
