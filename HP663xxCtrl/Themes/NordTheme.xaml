<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nord (https://www.nordtheme.com/) - cool arctic blue-gray palette -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFD8DEE9"/>

    <SolidColorBrush x:Key="GroupBoxBackgroundBrush" Color="#FF3B4252"/>
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#FF88C0D0"/>

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFD8DEE9"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFECEFF4"/>

    <SolidColorBrush x:Key="SplitterBackgroundBrush" Color="#FF434C5E"/>

    <!-- TextBox / ComboBox / numeric input boxes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FFECEFF4"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF4C566A"/>

    <!-- ZedGraph colors (applied in code-behind since the graph is WinForms-hosted) -->
    <Color x:Key="GraphBackColor">#FF2E3440</Color>
    <Color x:Key="GraphForeColor">#FFD8DEE9</Color>

    <!-- Default WPF control chrome reads these SystemColors keys directly,
         bypassing plain Background/Foreground setters - override them so
         native chrome (TabControl pane, disabled controls, menus) matches. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFD8DEE9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFECEFF4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF4C566A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF5A6479"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF3B4252"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF88C0D0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF4C566A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF2E3440"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFD8DEE9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#FF434C5E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#FF434C5E"/>

</ResourceDictionary>
